        "operation": "executeQuery",
        "query": "WITH claimed AS (\n  UPDATE giulia_lembretes\n  SET status = 'processando'\n  WHERE id IN (\n    SELECT id FROM giulia_lembretes\n    WHERE status = 'pendente'\n      AND disparar_em <= NOW() AT TIME ZONE 'America/Sao_Paulo'\n    FOR UPDATE SKIP LOCKED\n    LIMIT 20\n  )\n  RETURNING id, descricao, disparar_em, recorrencia\n)\nSELECT id, descricao, disparar_em, recorrencia FROM claimed;",
        "options": {}
      },
