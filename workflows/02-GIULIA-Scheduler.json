    {
      "parameters": {
        "jsCode": "// Lembretes -> mensagem pro Thiago\nconst THIAGO_NUMERO = '5511910441709';\nconst lembretes = items.filter(i => i.json && i.json.id);\n\nreturn lembretes.map(l => {\n  const j = l.json;\n  const isRec = j.recorrencia && ['diaria','semanal','mensal'].includes(j.recorrencia);\n  const interval = j.recorrencia === 'diaria' ? '1 day' : j.recorrencia === 'semanal' ? '7 days' : '1 month';\n  const recSql = isRec\n    ? `INSERT INTO giulia_lembretes (descricao, disparar_em, recorrencia) VALUES ('${String(j.descricao).replace(/'/g,\"''\")}', ('${j.disparar_em}'::TIMESTAMP + INTERVAL '${interval}'), '${j.recorrencia}');`\n    : '';\n  return {\n    json: {\n      tipo: 'lembrete',\n      lembrete_id: j.id,\n      send_to: THIAGO_NUMERO,\n      send_text: `Lembrete: ${j.descricao}`,\n      finalize_sql: `UPDATE giulia_lembretes SET status = 'enviado', enviado_em = NOW() WHERE id = ${j.id};${recSql}`\n    }\n  };\n});"
      },
      "id": "code-prep-lembretes",
      "name": "Preparar Lembretes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 100]
    },
    {
      "parameters": {
        "jsCode": "// Msgs agendadas pra terceiros\nconst msgs = items.filter(i => i.json && i.json.id);\n\nreturn msgs.map(m => {\n  const j = m.json;\n  const numero = String(j.destinatario_numero || '').replace(/[^0-9]/g,'');\n  return {\n    json: {\n      tipo: 'mensagem',\n      msg_id: j.id,\n      send_to: numero,\n      send_text: j.conteudo,\n      destinatario_nome: j.destinatario_nome,\n      finalize_sql: `UPDATE giulia_mensagens_agendadas SET status = 'enviado', enviado_em = NOW() WHERE id = ${j.id};`\n    }\n  };\n});"
      },
      "id": "code-prep-msgs",
      "name": "Preparar Msgs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 460]
    },
    {
      "parameters": {
        "jsCode": "// Notificacoes -> mensagem pro Thiago no numero principal\nconst THIAGO_NUMERO = '5511910441709';\nconst notifs = items.filter(i => i.json && i.json.id);\n\nconst tipoLabel = { lead_novo: 'LEAD', agendamento_pendente: 'AGENDAMENTO', recado: 'RECADO', encaminhamento: 'ENCAMINHAMENTO' };\nconst urgPrefix = { urgente: '[URGENTE] ', normal: '', info: '[info] ' };\n\nreturn notifs.map(n => {\n  const j = n.json;\n  const prefix = (urgPrefix[j.urgencia] || '') + (tipoLabel[j.tipo] || j.tipo.toUpperCase());\n  const origem = j.origem_nome ? `${j.origem_nome} (${j.origem_numero})` : j.origem_numero;\n  return {\n    json: {\n      tipo: 'notificacao',\n      notif_id: j.id,\n      send_to: THIAGO_NUMERO,\n      send_text: `${prefix}\\nDe: ${origem}\\n\\n${j.resumo}`,\n      finalize_sql: `UPDATE giulia_notificacoes_thiago SET status = 'enviada', enviada_em = NOW() WHERE id = ${j.id};`\n    }\n  };\n});"
      },
      "id": "code-prep-notif",
      "name": "Preparar Notificacoes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 280]
    },
