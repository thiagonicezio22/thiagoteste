              "value": "__GIULIA_UAZAPI_TOKEN__"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.send_to, text: $json.send_text }) }}",
        "options": {
          "timeout": 30000
        }
      },
