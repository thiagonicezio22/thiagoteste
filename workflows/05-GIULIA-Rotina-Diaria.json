    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, dia_semana, tarefa, hora_aviso, hora_reforco\nFROM giulia_rotina\nWHERE ativa = TRUE\n  AND dia_semana = EXTRACT(DOW FROM (NOW() AT TIME ZONE 'America/Sao_Paulo'))::INT\nORDER BY id;",
        "options": {}
      },
