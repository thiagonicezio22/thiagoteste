        540
      ],
      "credentials": {
        "postgres": {
          "id": "qSNNpS1TadimC3ND",
          "name": "PostgreSQL Julian"
        }
      },
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// Monta mensagem aviso (manha) ou reforco (tarde) pro Thiago\nconst THIAGO_NUMERO = '5511910441709';\nconst tarefas = items.filter(i => i.json && i.json.tarefa);\n\nlet tipo = 'aviso';\ntry { tipo = $('Set tipo=aviso').first().json.tipo; } catch(e) {}\nif (!tipo || tipo === undefined) {\n  try { tipo = $('Set tipo=reforco').first().json.tipo; } catch(e) {}\n}\n\nlet textoFinal = '';\nif (!tarefas.length) {\n  // dia livre - so manda no aviso\n  if (tipo === 'aviso') textoFinal = 'Bom dia. Hoje voce ta livre, sem tarefas na rotina.';\n  else return [];\n} else {\n  const lista = tarefas.map(t => `- ${t.json.tarefa}`).join('\\n');\n  if (tipo === 'aviso') {\n    textoFinal = `Bom dia. Hoje tem na rotina:\\n${lista}\\n\\nVou te lembrar de novo ao meio dia pra ver como ficou.`;\n  } else {\n    textoFinal = `Como foi a rotina de hoje? Lembra:\\n${lista}\\n\\nJa fez tudo? Falta alguma coisa?`;\n  }\n}\n\nif (!textoFinal) return [];\nreturn [{ json: { send_to: THIAGO_NUMERO, send_text: textoFinal, tipo } }];"
      },
      "id": "code-build",
      "name": "Montar Mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        540
      ]
    },
    {
